# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- JWT signing key (HMAC-SHA256, hex string) ---
# Generate a new one for any non-local environment, e.g.:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-64-char-hex-secret
